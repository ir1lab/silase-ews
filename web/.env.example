# Salin menjadi .env lalu isi. Berkas .env tidak boleh masuk git.

# --- Basis data (MariaDB 11 / MySQL 8)
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=silase
DB_USER=silase
DB_PASS=ganti-kata-sandi-db

# --- Broker MQTT (akun khusus web: baca data/status, tulis cmd)
# Skema: wss:// atau ws:// (MQTT lewat WebSocket), mqtts:// atau mqtt:// (TCP).
MQTT_URL=wss://mqtt.ir1lab.id:443
MQTT_USER=silase-web
MQTT_PASS=ganti-kata-sandi-broker
# Berkas CA broker (PEM), opsional; kosong = pakai CA bawaan sistem
MQTT_CA_FILE=
MQTT_CLIENT_ID=silase-web-ingest
MQTT_TOPIC_ROOT=silase-ews

# --- Simulator (akun broker setara node: tulis data/status).
# Kosongkan untuk memakai akun MQTT_* di atas (hanya cocok di broker uji).
SIM_MQTT_USER=
SIM_MQTT_PASS=

# --- Aplikasi
APP_TZ=Asia/Jakarta
# 1 = tampilkan rincian galat di halaman (hanya saat pengembangan)
APP_DEBUG=0
# Folder log; kosong = web/storage/log
LOG_DIR=

# --- WhatsApp (kosongkan WA_GATEWAY_URL bila gateway belum ada)
WA_PROVIDER=gateway
WA_GATEWAY_URL=
WA_GATEWAY_KEY=
WA_GATEWAY_SESSION=default
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_ID=
WA_CLOUD_TEMPLATE=
WA_CLOUD_LANG=id
WA_CLOUD_API_VERSION=v21.0

# --- Email ke admin saat WhatsApp terputus (opsional)
MAILER_DSN=
MAIL_FROM=
ADMIN_EMAIL=

# --- Hanya untuk mencoba secara lokal tanpa MariaDB: pakai berkas SQLite.
# Bila diisi, DB_HOST dkk. diabaikan. Jangan dipakai di produksi.
# DB_SQLITE=/tmp/silase-coba.sqlite

# --- Login. Bila tiga nilai ini diisi, login HANYA lewat akun Google dan
# aplikasi harus dibuka dari APP_URL. Bila kosong, login memakai kata sandi.
#   APP_URL             : alamat resmi aplikasi, mis. https://silase.ir1lab.id
#   GOOGLE_CLIENT_ID    : dari Google Cloud Console (OAuth client jenis "Web application")
#   GOOGLE_CLIENT_SECRET: pasangannya
# Authorized redirect URI di Google: <APP_URL>/masuk/google/balik
APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
