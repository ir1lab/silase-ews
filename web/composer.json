{
    "name": "ir1lab/silase-ews-web",
    "description": "Dasbor web SILASE-EWS: ingest MQTT, peringatan dini, dan ekspor data fermentasi silase.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "php-mqtt/client": "^2.2",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "Silase\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Silase\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
