# deploy/ir1server/.env. pasang.sh membuat berkas ini dengan kata sandi basis
# data acak bila belum ada; isi MQTT_USER dan MQTT_PASS sendiri.
# Port web di host. Ganti bila 8088 sudah dipakai layanan lain.
SILASE_PORT=8088

DB_HOST=mariadb
DB_PORT=3306
DB_NAME=silase
DB_USER=silase
DB_PASS=

MQTT_URL=wss://mqtt.ir1lab.id:443
MQTT_USER=silase-web
MQTT_PASS=
MQTT_CLIENT_ID=silase-web-ingest
MQTT_TOPIC_ROOT=silase-ews

APP_TZ=Asia/Jakarta
APP_DEBUG=0
