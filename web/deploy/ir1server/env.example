# deploy/ir1server/.env. pasang.sh membuat berkas ini dengan kata sandi basis
# data acak bila belum ada; isi MQTT_USER dan MQTT_PASS sendiri.
# Port web di host. Ganti bila 8088 sudah dipakai layanan lain.
SILASE_PORT=8088

DB_HOST=mariadb
DB_PORT=3306
DB_NAME=silase
DB_USER=silase
DB_PASS=

MQTT_URL=wss://mqtt.ir1lab.id:443
MQTT_USER=silase-web
MQTT_PASS=
MQTT_CLIENT_ID=silase-web-ingest
MQTT_TOPIC_ROOT=silase-ews

APP_TZ=Asia/Jakarta
APP_DEBUG=0

# --- WhatsApp. Kosongkan WA_GATEWAY_URL selama gateway belum dinyalakan:
# peringatan tetap tercatat di dasbor, hanya pesannya yang tidak dikirim.
# Untuk mengaktifkan: isi WA_GATEWAY_URL=http://silase-waha:3000 lalu
#   docker compose --profile wa up -d && docker compose up -d --force-recreate web notifikasi
WA_PROVIDER=gateway
WA_GATEWAY_URL=
# Kunci API gateway; pasang.sh mengisinya dengan nilai acak bila kosong.
WA_GATEWAY_KEY=
WA_GATEWAY_SESSION=default

# WhatsApp Cloud API resmi (dipakai setelah layanan stabil: WA_PROVIDER=cloud_api).
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_ID=
WA_CLOUD_TEMPLATE=
WA_CLOUD_LANG=id
WA_CLOUD_API_VERSION=v21.0

# --- Email ke admin saat WhatsApp terputus (opsional).
# Contoh: MAILER_DSN=smtp://pengguna:sandi@smtp.contoh.ac.id:587
MAILER_DSN=
MAIL_FROM=
# Satu atau beberapa alamat, dipisah koma.
ADMIN_EMAIL=

# --- Login. Bila tiga nilai ini diisi, login HANYA lewat akun Google dan
# aplikasi harus dibuka dari APP_URL. Bila kosong, login memakai kata sandi.
#   APP_URL             : alamat resmi aplikasi, mis. https://silase.ir1lab.id
#   GOOGLE_CLIENT_ID    : dari Google Cloud Console (OAuth client jenis "Web application")
#   GOOGLE_CLIENT_SECRET: pasangannya
# Authorized redirect URI di Google: <APP_URL>/masuk/google/balik
APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
